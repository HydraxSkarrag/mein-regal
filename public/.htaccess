# Bücherregal - Apache configuration (all-inkl runs Apache)
#
# This is configuration, not authentication: signing in is handled by the
# application. Nothing security-critical lives in this directory in the first
# place - the application code sits one level above the document root - so the
# rules here are a second line of defence.

Options -Indexes

# Dotfiles (.htaccess, .git*, .env, ...)
<FilesMatch "^\.">
  Require all denied
</FilesMatch>

# Nothing but the front controller should ever be requested directly.
<FilesMatch "\.(sql|md|json|yml|yaml|lock|dist|sample\.php|log|zip|tar|gz|bak|sqlite)$">
  Require all denied
</FilesMatch>

DirectoryIndex index.php

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Force HTTPS. The barcode scanner needs it - getUserMedia is refused on
  # an insecure origin - and so does the Secure flag on the session cookie.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # Existing files (CSS, JS, images, covers) are served as they are;
  # everything else goes to the front controller.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.php [L]
</IfModule>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"

  # The camera must be allowed for this origin, or the scanner silently
  # fails. The neighbouring bookaholic site sets camera=() - copying that
  # file verbatim would break the one feature this site exists for.
  Header set Permissions-Policy "geolocation=(), microphone=(), camera=(self)"

  # The Content-Security-Policy is NOT here. It carries a nonce that differs
  # on every request, and a static file cannot mint one - see App\Core\Csp,
  # which sends it. A second policy here would not be a safety net either: a
  # browser enforces every policy it is given, so this one would go on
  # blocking exactly what that one allows.
  #
  # These headers stay, because they are the same on every response and
  # because they then also cover the CSS, the fonts and the cover images,
  # which never reach PHP at all.

  Header always set Strict-Transport-Security "max-age=15552000; includeSubDomains"
</IfModule>

# Second line of defence: should PHP run as a module and the application fail
# to start at all, a warning still must not reach the browser.
<IfModule mod_php.c>
  php_flag display_errors Off
  php_flag log_errors On
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# Bücherregal - Apache configuration (all-inkl runs Apache)
#
# This is configuration, not authentication: signing in is handled by the
# application. Nothing security-critical lives in this directory in the first
# place - the application code sits one level above the document root - so the
# rules here are a second line of defence.

Options -Indexes

# Dotfiles (.htaccess, .git*, .env, ...)
<FilesMatch "^\.">
  Require all denied
</FilesMatch>

# Nothing but the front controller should ever be requested directly.
<FilesMatch "\.(sql|md|json|yml|yaml|lock|dist|sample\.php|log)$">
  Require all denied
</FilesMatch>

DirectoryIndex index.php

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Force HTTPS. The barcode scanner needs it - getUserMedia is refused on
  # an insecure origin - and so does the Secure flag on the session cookie.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # Existing files (CSS, JS, images, covers) are served as they are;
  # everything else goes to the front controller.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.php [L]
</IfModule>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"

  # The camera must be allowed for this origin, or the scanner silently
  # fails. The neighbouring bookaholic site sets camera=() - copying that
  # file verbatim would break the one feature this site exists for.
  Header set Permissions-Policy "geolocation=(), microphone=(), camera=(self)"

  # The site loads nothing from anywhere else - no CDN, no web fonts, no
  # analytics - so this can be as strict as it looks. It stays true only as
  # long as that holds; the first external script would have to loosen it,
  # and would also cost the site its consent-banner-free standing.
  #
  # img-src names the few hosts a cover can come from rather than allowing
  # https: outright. Covers are downloaded and served from here, so a visitor
  # never needs any of them; what does is the scanner, which shows the
  # candidate cover straight from the source before anyone has decided to
  # keep it. Naming them closes the one channel a policy like this otherwise
  # leaves wide open: an image request carries data in its address, and "any
  # https host" is somewhere to send it. The hosts are the ones in
  # CoverStorage's fetch allowlist, kept in step by hand: Open Library
  # redirects its covers onto the Internet Archive, and a browser follows
  # that redirect too. If a preview ever fails to appear while the cover
  # still saves correctly, this line is why - add the host it came from.
  Header set Content-Security-Policy "default-src 'self'; img-src 'self' data: https://books.google.com https://books.googleusercontent.com https://lh3.googleusercontent.com https://covers.openlibrary.org https://archive.org https://*.archive.org; script-src 'self'; style-src 'self'; font-src 'self'; connect-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'"

  Header always set Strict-Transport-Security "max-age=15552000; includeSubDomains"
</IfModule>

# Second line of defence: should PHP run as a module and the application fail
# to start at all, a warning still must not reach the browser.
<IfModule mod_php.c>
  php_flag display_errors Off
  php_flag log_errors On
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

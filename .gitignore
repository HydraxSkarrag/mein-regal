# Real credentials - NEVER commit.
#
# The leading slash matters: without it the pattern matches at every level,
# and app/Core/Config.php - the class that reads the file - was quietly
# excluded from the repository. Cloning gave a broken application.
/config.php
/config.php.bak
/config.dev.php
*.local

# User data: uploaded covers, logs, import reports, exports
storage/
public/covers/*
!public/covers/.gitkeep

# The operator's own logo and icons. They override the neutral defaults that
# ship in public/assets/, they belong to whoever made them, and a deploy must
# never carry one installation's brand into another.
public/assets/brand/

# The library export itself has no place in the repository - not even a
# private one. Test fixtures are small, synthetic and deliberately kept.
*.csv
!tests/fixtures/*.csv

# Build / editor / OS noise
.claude/
.DS_Store
Thumbs.db
.idea/
.vscode/
*.log
node_modules/
vendor/
